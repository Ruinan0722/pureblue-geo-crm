# ========== 本地开发（API 代理到 geo-api）==========
# 复制为 .env.local
# 必填：GEO_API_URL 指向 geo-api；客户填报数据不再使用 SQLite / 直连 MySQL

GEO_API_URL=http://localhost:8000
# 提交前本地 SQLite 备份（默认 data/intake-submissions.sqlite3）
INTAKE_BACKUP_DATABASE_PATH=./data/intake-submissions.sqlite3
# 局域网访问时改成实际 IP，例如 http://localhost:47822
NEXT_PUBLIC_APP_URL=http://localhost:47822
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:47821/login
# 本地务必留空或设为同源路径（由 Next rewrite 到 GEO_API_URL）；勿填 pressgo 生产地址，否则会 CORS
# NEXT_PUBLIC_INTAKE_SUBMIT_URL=/api/intake/submit
# 允许局域网 hostname 的 HMR（逗号分隔）
# DEV_ALLOWED_ORIGINS=10.10.22.167
