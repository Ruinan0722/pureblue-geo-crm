# ========== 本地开发环境（geo-api）==========
# 复制为 .env 后填写飞书等密钥
APP_ENV=development
# 产品环境标识（与 admin GEO_ENV 对齐）；空则回落 APP_ENV
GEO_ENV=development
# 仅 GEO_ENV=staging 时生效；false=按 RBAC 数据范围
STAGING_FORCE_OWN_SCOPE=false
# 可选功能开关覆盖（见 docs/ops/deploy.md）
# GEO_FEATURE_API_DOCS=true
# GEO_FEATURE_HEALTH_CACHE_METRICS=true
# 本地可空（接口回落 "dev"）；生产由部署脚本注入 Git tag，勿手写进 .env 当权威
# APP_VERSION=v1.2.0
API_HOST=0.0.0.0
API_PORT=8000
# 本地开发建议 4；单 worker 调试可设 API_WORKERS=1（启用 --reload）
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:47821,http://localhost:47822,http://127.0.0.1:47821,http://127.0.0.1:47822
# 局域网调试 intake/admin 时按需追加，例如：
# API_CORS_ORIGINS=...,http://localhost:47821,http://localhost:47822

# MySQL（Docker geo-mysql；./scripts/setup-local-dev.sh 初始化完整库）
# 测试库：./scripts/setup-local-test-db.sh 创建 geo_crm_dev
# 切换：./scripts/use-local-db.sh geo_crm|geo_crm_dev
# LOCAL_MYSQL_DATABASE=geo_crm
DATABASE_URL=mysql+asyncmy://demo:replace-me@127.0.0.1:3306/geo_crm_demo
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=20

# Redis（Docker geo-redis；与 geo-admin REDIS_* 前缀必须一致）
# 本地默认可无密码；生产：REDIS_PASSWORD=xxx 且 REDIS_URL=redis://:xxx@host:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PASSWORD=
REDIS_KEY_PREFIX=local
REDIS_CACHE_ENABLED=true
REDIS_CRM_CACHE_ENABLED=true
REDIS_CONNECT_TIMEOUT_MS=200
REDIS_OP_TIMEOUT_MS=100
# 路径 B 备选失效（空则禁用）；与 geo-admin REDIS_INTERNAL_TOKEN 一致
REDIS_INTERNAL_TOKEN=

# JWT 会话（与后续 admin/intake 切 api 时保持一致）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# development / staging / test 固定 7 天；production 固定 1 天
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=
JWT_COOKIE=geo_access_token

# 客户邀请 Cookie（填报端）
INVITE_COOKIE=geo_invite_token

# 门户 URL（本地）
ADMIN_PORTAL_URL=http://localhost:47821
CUSTOMER_PORTAL_URL=http://localhost:47822

# 飞书 OAuth
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8000/api/auth/feishu/callback
FEISHU_TENANT_KEY=
FEISHU_SALES_DEPARTMENTS=销售部
FEISHU_VIEWER_DEPARTMENTS=客户成功,销售运营
FEISHU_SALES_DEPARTMENT_IDS=
FEISHU_SKIP_DEPARTMENT_CHECK=true
ADMIN_FEISHU_OPEN_IDS=
# 唯一超级管理员（飞书 open_id）；优先于 ADMIN_FEISHU_OPEN_IDS
SUPER_ADMIN_FEISHU_OPEN_ID=

# 飞书通讯录定时同步（users + feishu_sales_contacts，geo-api 进程内单任务）
# 多 worker 时仅一个进程持有调度锁；启动同步有 15 分钟冷却防重复
FEISHU_ORG_SYNC_ENABLED=true
FEISHU_ORG_SYNC_INTERVAL_HOURS=3
# 服务启动时是否立即同步一次（开发环境建议 false，避免 reload/多 worker 频繁打飞书）
FEISHU_ORG_SYNC_ON_STARTUP=false

# 客户「下次计划跟进」到期提醒（北京时间每日定点；多 worker 仅一进程调度）
FOLLOW_UP_REMINDER_ENABLED=true
FOLLOW_UP_REMINDER_HOUR=8

# 打卡现场照片本地落盘（暂不上云；目录勿提交 git）
CHECKIN_ATTACHMENTS_DIR=data/checkin-attachments
CHECKIN_ATTACHMENT_MAX_BYTES=10485760
CHECKIN_ATTACHMENT_MAX_COUNT=9

# Mark 公网集成（默认关闭；联调时配置随机共享密钥）
LEAD_INTEGRATION_ENABLED=false
# 三平台必须使用不同密钥；通用 LEAD_INTEGRATION_SECRET 仅供本地兼容。
LEAD_INTEGRATION_SECRET=
LEAD_INTEGRATION_WEBSITE_SECRET=
LEAD_INTEGRATION_36KR_SECRET=
LEAD_INTEGRATION_MARK_SECRET=
# 推荐第三方接入：请求体 platformCode + Authorization: Bearer <平台 API Key>
LEAD_INTEGRATION_WEBSITE_TOKEN=
LEAD_INTEGRATION_36KR_TOKEN=
LEAD_INTEGRATION_MARK_TOKEN=
# 兼容旧 HMAC 调用；完成迁移后设为 false
LEAD_INTEGRATION_LEGACY_HMAC_ENABLED=true
LEAD_INTEGRATION_TIMESTAMP_TOLERANCE_SECONDS=300
MARK_INTEGRATION_FILES_DIR=data/mark-integration-files
MARK_INTEGRATION_PDF_MAX_BYTES=26214400
MARK_INTEGRATION_FILE_HOSTS=your-bucket.s3.amazonaws.com
MARK_INTEGRATION_ALLOW_PRIVATE_HOSTS=false
MARK_INTEGRATION_PRIVATE_CIDRS=
MARK_INTEGRATION_DOWNLOAD_TIMEOUT_SECONDS=60
MARK_INTEGRATION_WORKER_INTERVAL_SECONDS=15
MARK_INTEGRATION_MAX_ATTEMPTS=5
RATE_LIMIT_INTEGRATION_PER_MINUTE=120

# 飞书组织全量同步并发（每个 worker）
FEISHU_ORG_SYNC_CONCURRENCY=8
# 按部门并发发现成员（find_by_department）
FEISHU_ORG_DISCOVER_CONCURRENCY=16
# 从这些根部门子树发现新成员（open_department_id，逗号分隔）
# 实际发现还会自动合并：应用通讯录 scopes 可见部门 + 租户根部门 0 直属成员
FEISHU_ORG_ROOT_DEPARTMENT_IDS=
# 飞书未返回部门 name 时，可选 ID→中文名映射文件
FEISHU_DEPARTMENT_LABELS_PATH=
FEISHU_DEPARTMENT_MAP_PATH=
