# ========== 本地开发（geo-api 联调）==========
# 复制为 .env.local
# 前端进程不直连 MySQL / Redis：所有数据与鉴权均经 geo-api
# 必填：GEO_API_URL

# 核心 API 代理到 geo-api
GEO_API_URL=http://localhost:8000

# JWT（须与 geo-api/.env 一致）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_COOKIE=geo_access_token

# Redis 仅 geo-api 使用（缓存失效/内部令牌）；前端无需任何 REDIS_* 配置

NEXT_PUBLIC_APP_URL=http://localhost:47821
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:47822
# 环境：development | staging | production（客户端需 NEXT_PUBLIC_GEO_ENV）
GEO_ENV=development
NEXT_PUBLIC_GEO_ENV=development
# 功能开关（可选覆盖默认矩阵，见 docs/ops/deploy.md）
# GEO_FEATURE_DEV_IDENTITY=true
# GEO_FEATURE_DEBUG_BANNERS=true
# 销售/负责人下拉默认走飞书组织；仅联调旁路才开：
# GEO_FEATURE_DEV_SALES_NAMES=true
# 兼容旧开关：ALLOW_DEV_IDENTITY=true → 开启测身份
# 软刷新版本号；本地默认 dev。生产由 docker build --build-arg NEXT_PUBLIC_APP_VERSION=$DEPLOY_GIT_TAG 注入
# NEXT_PUBLIC_APP_VERSION=dev
# 可选：通知 WebSocket 基址（默认本地 ws://<hostname>:8000）
# NEXT_PUBLIC_GEO_API_WS_URL=ws://localhost:8000

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:47821/api/auth/feishu/callback
FEISHU_TENANT_KEY=
ADMIN_FEISHU_OPEN_IDS=
# 唯一超级管理员（飞书 open_id）；优先于 ADMIN_FEISHU_OPEN_IDS
SUPER_ADMIN_FEISHU_OPEN_ID=
FEISHU_SALES_DEPARTMENTS=销售部
FEISHU_SALES_DEPARTMENT_IDS=
FEISHU_VIEWER_DEPARTMENTS=客户成功,销售运营
FEISHU_SKIP_DEPARTMENT_CHECK=true
